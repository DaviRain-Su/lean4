#!/usr/bin/env bash
set -euo pipefail

# Wrapper for compiling Lean-generated Zig code into an executable.
# Usage: zigc [--profile=native|near] <input.zig> [output-name]
#
# Profiles:
#   native (default): host executable linking the C++ Lean runtime + GMP + libuv.
#   near:             NEAR VM-compatible MVP WASM module (wasm32-freestanding).
#
# The native profile uses BUILD_DIR / LEANC to locate the stage build outputs.
# It links against the C++ Lean runtime and standard library.

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

PROFILE=native
if [[ "${1:-}" == "--profile=near" ]]; then
  PROFILE=near
  shift
fi

if [[ "$PROFILE" == "near" ]]; then
  exec "$ROOT/tools/zigc-near" "$@"
fi
BUILD_DIR="${BUILD_DIR:-$ROOT/build/release/stage1}"
LEANC="${LEANC:-$BUILD_DIR/bin/leanc}"
if [[ ! -x "$LEANC" ]]; then
  echo "zigc: leanc not found at $LEANC" >&2
  exit 1
fi

INPUT="$1"
OUTPUT="${2:-$(basename "$INPUT" .zig)}"

EXTRA_FLAGS=()

# Discover library search paths for gmp and libuv. Environment variables
# GMP_LIB_DIR / LIBUV_LIB_DIR take precedence; otherwise fall back to
# pkg-config and then platform-specific defaults.
add_lib_dir() {
  local dir="$1"
  if [[ -d "$dir" ]]; then
    EXTRA_FLAGS+=("-L$dir")
  fi
}

if [[ -n "${GMP_LIB_DIR:-}" ]]; then
  add_lib_dir "$GMP_LIB_DIR"
elif command -v pkg-config &>/dev/null && pkg-config --exists gmp 2>/dev/null; then
  add_lib_dir "$(pkg-config --variable=libdir gmp)"
fi

if [[ -n "${LIBUV_LIB_DIR:-}" ]]; then
  add_lib_dir "$LIBUV_LIB_DIR"
elif command -v pkg-config &>/dev/null && pkg-config --exists libuv 2>/dev/null; then
  add_lib_dir "$(pkg-config --variable=libdir libuv)"
fi

if [[ "$OSTYPE" == "darwin"* ]]; then
  # Homebrew on Apple Silicon vs Intel uses different prefixes.
  add_lib_dir /opt/homebrew/lib
  add_lib_dir /usr/local/lib
  EXTRA_FLAGS+=(-framework CoreFoundation)
fi
LEAN_RT_ZIG="$ROOT/src/runtime/zig/lean_rt.zig"
if [[ ! -f "$LEAN_RT_ZIG" ]]; then
  echo "zigc: shared runtime module not found at $LEAN_RT_ZIG" >&2
  exit 1
fi

zig build-exe --dep lean_rt -Mroot="$INPUT" -Mlean_rt="$LEAN_RT_ZIG" -O Debug \
  -I "$BUILD_DIR/include" \
  -L "$BUILD_DIR/lib/lean" \
  -lInit -lStd -lLean -lleanrt -lc++ -lgmp -luv -lpthread \
  "${EXTRA_FLAGS[@]}" \
  -femit-bin="$OUTPUT"
