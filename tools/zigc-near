#!/usr/bin/env bash
set -euo pipefail

# Compile Lean-generated Zig code into a NEAR-compatible WASM module.
#
# Usage: zigc-near <input.zig> [output.wasm]
#
# This wrapper produces a wasm32-freestanding MVP WASM module compatible with
# the NEAR VM. It disables all post-MVP features (bulk_memory, sign_ext, simd,
# multivalue, reference_types, atomics) and links against the Lean Zig runtime
# (libleanrt_zig) built with the NEAR host backend.
#
# Prerequisites:
#   - zig on PATH
#   - lean_rt.zig at src/runtime/zig/lean_rt.zig (the runtime entry)
#
# Environment:
#   LEAN_RT_ZIG   path to lean_rt.zig (default: <root>/src/runtime/zig/lean_rt.zig)
#   NEAR_OPTIMIZE optimization level (default: ReleaseSmall for minimal size)

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

INPUT="$1"
OUTPUT="${2:-$(basename "$INPUT" .zig).wasm}"

LEAN_RT_ZIG="${LEAN_RT_ZIG:-$ROOT/src/runtime/zig/lean_rt.zig}"
OPTIMIZE="${NEAR_OPTIMIZE:-ReleaseSmall}"

if [[ ! -f "$LEAN_RT_ZIG" ]]; then
  echo "zigc-near: lean_rt.zig not found at $LEAN_RT_ZIG" >&2
  exit 1
fi

# NEAR VM only supports MVP WASM (WebAssembly 1.0).
# Explicitly disable every post-MVP feature so the linker rejects any code
# that would emit unsupported instructions.
NEAR_CPU="baseline-bulk_memory-sign_ext-simd128-multivalue-reference_types-atomics"

exec zig build-exe \
  -target wasm32-freestanding \
  -fno-entry \
  -O "$OPTIMIZE" \
  -mcpu "$NEAR_CPU" \
  --dep lean_rt \
  -Mroot="$INPUT" \
  -Mlean_rt="$LEAN_RT_ZIG" \
  -femit-bin="$OUTPUT"
